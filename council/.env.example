# Скопируйте в .env и задайте значения локально. Секреты не отправляйте в чат.
# Запуск: python -m council.main --mode model
LLM_PROVIDER=aitunnel
LLM_MODEL=
AITUNNEL_API_KEY=
OPENAI_API_KEY=
# Необязательно, только если модель поддерживает. Пустое значение оставляет её default.
LLM_REASONING_EFFORT=
